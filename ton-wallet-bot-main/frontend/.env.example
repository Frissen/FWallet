# Copy to .env.local for development. In production set these as environment
# variables / Docker build args (see Dockerfile). VITE_* values end up in the
# public JS bundle - never put real secrets here.
VITE_BOT_USERNAME=FwalletBot
VITE_MINIAPP_SHORTNAME=Wallet
VITE_APP_BASE_URL=https://your-fwallet-domain.example
VITE_P2P_API_BASE=https://your-fwallet-domain.example
VITE_TONCENTER_API_KEY=
VITE_CHANGENOW_API_KEY=
